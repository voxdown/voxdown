{
  "name": "voxdown-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "site": "pnpm --filter voxdown-site dev",
    "site:build": "pnpm --filter voxdown-site build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fixtures": "pnpm --filter voxdown fixtures",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "site:check": "pnpm site:build && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "playwright": "1.63.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}

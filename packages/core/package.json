{
  "name": "voxdown",
  "version": "1.0.0",
  "description": "VoxDown: a plain-text format for stories read aloud. Parser, readings, writer, formatter and exports, with no dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["voxdown", "vxd", "audiobook", "script", "markdown", "text-to-speech", "parser"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxdown/voxdown.git",
    "directory": "packages/core"
  },
  "homepage": "https://voxdown.github.io/voxdown/",
  "bugs": "https://github.com/voxdown/voxdown/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "UPDATE_FIXTURES=1 vitest run test/conformance.test.ts"
  },
  "engines": { "node": ">=20" }
}
